                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"slotId\": \"your_slot_id\",\n    \"number\": 5,\n    \"amount\": 100\n}"
                        },
                        "url": "http://localhost:3000/color/api/user/bet"
