    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Register User",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Test User\",\n    \"email\": \"test@example.com\",\n    \"mobile\": \"1234567890\",\n    \"countryCode\": \"+91\",\n    \"parentReferralCode\": \"\"\n}"
                        },
                        "url": "http://localhost:3000/color/api/user/send/otp"
                    },
                    "response": []
                },
                {
                    "name": "Send Login OTP",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"countryCode\": \"+91\",\n    \"mobile\": \"1234567890\"\n}"
                        },
                        "url": "http://localhost:3000/color/api/user/login/otp"
                    },
                    "response": []
                },
                {
                    "name": "Verify Login OTP",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"countryCode\": \"+91\",\n    \"mobile\": \"1234567890\",\n    \"otp\": \"123456\"\n}"
                        },
                        "url": "http://localhost:3000/color/api/user/verify/otp"
                    },
                    "response": []
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "authkey",
                                "value": "{{authToken}}",
                                "type": "text"
                            }
                        ],
                        "url": "http://localhost:3000/color/api/user/logout"
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Game Management",
